# ---------------------------------------------------------------------------
# Al Manar Interactive Challenge - example environment file.
#
# Copy to `.env` and replace every placeholder:
#     cp .env.example .env        (Linux/macOS)
#     Copy-Item .env.example .env (Windows PowerShell)
#
# `.env` is git-ignored and must never be committed.
#
# This file documents every variable the application reads. The defaults shown
# are the ones in `config/settings/base.py`, so an empty value behaves exactly as
# the number beside it.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Which settings module to load: development | production
DJANGO_ENV=development

# Suffix of the settings module: config.settings.<name>
DJANGO_SETTINGS_MODULE_NAME=development

# REQUIRED. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Production refuses to start without it.
DJANGO_SECRET_KEY=

# Never enable in production. `config.settings.production` forces DEBUG False
# regardless of what is set here.
DEBUG=True

# Comma-separated. Use hostnames or IP addresses, never a wildcard.
# For the school server this is the server's name or address on 172.16.1.0/24,
# for example `challenge,172.16.1.20`. No address is ever hard-coded in code.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Only needed when the application is served on another origin than it is
# addressed as - for example behind a proxy terminating HTTPS on 443 while the
# browser talks to http://<host>. Example: https://challenge.school.local
CSRF_TRUSTED_ORIGINS=

APP_VERSION=0.1.0
TIME_ZONE=UTC
LOG_LEVEL=INFO

# The single address users and screens should open. Shown to operators so they
# are never told to guess a URL. Leave empty and the interface shows the host the
# operator is already on. This is the `PUBLIC_URL` of the deployment sheet.
PUBLIC_BASE_URL=

# Host port and interface to publish. Keep 0.0.0.0 when other school devices
# must reach the application; use 127.0.0.1 when a reverse proxy is in front.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8000

# Seconds the web container waits for PostgreSQL and Redis at startup.
SERVICE_WAIT_TIMEOUT=60


# ---------------------------------------------------------------------------
# Reverse proxy and WebSocket transport
# ---------------------------------------------------------------------------
#
# Read by `challenge-proxy` and `challenge-web` in the production overlay
# (`docker-compose.prod.yml`). In development there is no proxy, so these have
# no effect and nothing warns that they are unused.
#
# The values shown are the defaults compiled into the production overlay, and
# are what this deployment is currently running. They are documented here
# because an operator tuning them needs to know they exist: without this
# section the effective proxy configuration is invisible from the repository.

# The one address and port published to the school network. Nothing else is.
# 0.0.0.0 so classroom screens on any VLAN can reach it.
PROXY_BIND_ADDRESS=0.0.0.0
PROXY_PORT=80

# Burst control at the proxy, applied per client address before a request
# reaches the application. Sized for a whole classroom behind one NAT address.
# Measured on the target server: a burst of 200 requests from one address is
# answered 120 x 404 then refused with 429, which is this limit engaging.
NGINX_RATE_LIMIT_PER_IP=30r/s
NGINX_RATE_LIMIT_BURST=120

# How long a WebSocket may stay idle before the proxy closes it. A lesson can
# sit between questions for minutes, so this must comfortably exceed
# LIVE_HEARTBEAT_SECONDS. The deployment-config test suite enforces that.
NGINX_PROXY_READ_TIMEOUT=600s
NGINX_PROXY_SEND_TIMEOUT=600s

# Daphne WebSocket frame limits. Daphne defaults both to 0, meaning no limit,
# and its own help calls that unsafe: one unauthenticated screen socket could
# then allocate unbounded memory with a single frame. The largest real message
# is a short-answer submission, well under a kilobyte.
WS_MAX_MESSAGE_SIZE=65536
WS_MAX_FRAME_SIZE=16384

# Transport-level keepalive: ping a socket idle this long, close it if no pong
# arrives. The application heartbeat (LIVE_HEARTBEAT_SECONDS) is the other half.
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=60


# ---------------------------------------------------------------------------
# PostgreSQL - the only persistent datastore
# ---------------------------------------------------------------------------
# These values are used twice: they create the database in the challenge-db
# container and they configure the Django connection. Change them before the
# first `docker compose up`; changing them later requires manual SQL work.
DATABASE_NAME=challenge
DATABASE_USER=challenge
DATABASE_PASSWORD=
# Overridden by docker-compose.yml with the in-network service name.
DATABASE_HOST=challenge-db
DATABASE_PORT=5432

# Optional explicit test database name. Empty means Django uses test_<DATABASE_NAME>.
DATABASE_TEST_NAME=
# Persistent connections are held this long. 60 suits a school server.
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT=10


# ---------------------------------------------------------------------------
# Redis - cache and Django Channels transport
# ---------------------------------------------------------------------------
# Overridden by docker-compose.yml with the in-network service name.
REDIS_HOST=challenge-redis
REDIS_PORT=6379
REDIS_DB=0
# Leave empty: the Redis service is only reachable on the private project
# network. Set a value here and in the redis service if you add authentication.
REDIS_PASSWORD=

CACHE_KEY_PREFIX=almanar-challenge
CACHE_TIMEOUT=300

# Messages the Redis transport will hold for a full group before dropping the
# oldest. 1500 is far above any realistic school (see PERFORMANCE.md).
CHANNEL_LAYER_CAPACITY=1500

# How long a group membership survives with no traffic, in seconds.
#
# DO NOT LOWER THIS. The heartbeat (LIVE_HEARTBEAT_SECONDS, 15s) is what keeps
# membership alive; this is only the backstop. Anything close to or below the
# heartbeat interval makes an idle screen's subscription lapse between beats, and
# a screen that is silently unsubscribed keeps showing the last question it
# received with nothing on the board to indicate it is stale. Keep it far above
# LIVE_HEARTBEAT_SECONDS - 300 is the tested value.
CHANNEL_LAYER_EXPIRY=300


# ---------------------------------------------------------------------------
# Interactive screens
# ---------------------------------------------------------------------------

# A screen counts as online while its last heartbeat is within this window.
# Must comfortably exceed the heartbeat interval or screens flicker.
SCREEN_ONLINE_WINDOW_SECONDS=90

# How often the screen page records a heartbeat.
SCREEN_HEARTBEAT_INTERVAL_SECONDS=30

# Whether to honour X-Forwarded-For when recording a screen's address.
#
# Leave False unless the application genuinely sits behind a reverse proxy you
# control that rewrites the header. Honouring it while exposed directly would let
# any client forge the address that appears in the screen list.
#
# The production overlay sets this to True, and that is only safe because
# deploy/nginx sets `proxy_set_header X-Forwarded-For $remote_addr` - it OVERWRITES
# the header with the real peer address. Do not change it to
# `$proxy_add_x_forwarded_for`: that keeps whatever the client sent in the
# left-most position, which is the position the application reads, and a client
# could then send a fresh value on every request and walk straight through the
# Screen ID rate limit.
SCREEN_TRUST_FORWARDED_FOR=False


# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
#
# The Screen ID and the password are the only secrets a client ever presents, so
# both are counted per client address. The limits are deliberately generous: a
# whole classroom can sit behind one NAT address and every screen reconnects on
# its own. Lower them only after watching the logs for real throttling.

# Screen ID presentations, per address, per window.
SCREEN_RATE_LIMIT=120
SCREEN_RATE_LIMIT_WINDOW=60

# Sign-in attempts, per username per address, per window. The per-address limit
# is this number multiplied by the factor below, so spraying many usernames from
# one address is bounded too.
#
# THE QUOTA IS ON ATTEMPTS, NOT FAILURES: a *successful* sign-in consumes it
# exactly as a wrong password does, and once the quota is spent every further
# attempt in the window is refused without the password being checked - including
# a correct one. That is deliberate: whether an attempt would have succeeded is
# what an attacker controls, so it must not change what an attempt costs. The
# practical consequence is that a shared staff-room PC cannot sign in more than
# this many times inside the window; raise it if a room genuinely needs to.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_LIMIT_WINDOW=300
LOGIN_RATE_LIMIT_ACCOUNT_FACTOR=5


# ---------------------------------------------------------------------------
# Live competitions
# ---------------------------------------------------------------------------

# How often an attached screen is sent a clock beacon carrying server time.
# Must exceed the WebSocket ping interval.
LIVE_TICK_INTERVAL_SECONDS=5

# How often the server pings every round it is hosting. This is what actually
# keeps screen subscriptions alive between teacher actions. Must stay well under
# CHANNEL_LAYER_EXPIRY.
LIVE_HEARTBEAT_SECONDS=15

# A question shorter than this is refused.
MIN_QUESTION_DURATION_SECONDS=5

# Screen reconnect backoff, in seconds.
LIVE_RECONNECT_DELAY_SECONDS=2
LIVE_RECONNECT_MAX_DELAY_SECONDS=15


# ---------------------------------------------------------------------------
# Scoring defaults
# ---------------------------------------------------------------------------
# Used by any competition with no scoring rule of its own. A competition may
# override all three in the admin.
SCORING_CORRECT_POINTS=100

# Most extra points available for answering quickly, and how they are earned:
# `linear` pays the full bonus at the start of a question, decaying to nothing by
# its deadline; `none` disables the bonus whatever the maximum says.
SCORING_SPEED_BONUS_MAX=50
SCORING_SPEED_BONUS_MODE=linear


# ---------------------------------------------------------------------------
# Static and media files
# ---------------------------------------------------------------------------
# Given relative to /app inside the container. Uploaded question images live in
# the challenge-media volume; the proxy serves them, never Django.
STATIC_URL=/static/
STATIC_ROOT_DIR=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT_DIR=media


# ---------------------------------------------------------------------------
# Production-only settings (config.settings.production)
# ---------------------------------------------------------------------------
# Leave the cookie flags at their defaults only once HTTPS is confirmed on the
# target server: with SESSION_COOKIE_SECURE=True over plain HTTP the browser will
# refuse to send the session cookie and nobody can sign in.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# How long a signed-in session stays valid, in seconds.
#
# Twelve hours, not the framework default of fourteen days. One teacher's day is
# one contiguous block, so this covers a full day including a late-afternoon
# competition, and cannot expire mid-lesson. What it does not cover is a shared
# staff-room machine left signed in overnight: a fortnight-long cookie stays
# usable for two weeks, which is long enough to be the whole attack. Raise it if
# the school signs in once a week.
SESSION_COOKIE_AGE=43200

# Upload limits. A question image is a photograph, not a document.
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880