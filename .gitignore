.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
backend/staticfiles/
backend/media/
*.log
*.sqlite3
db.sqlite3
local_settings.py

# ---------------------------------------------------------------------------
# Test and tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.tox/

# ---------------------------------------------------------------------------
# PostgreSQL backups
# ---------------------------------------------------------------------------
# deploy/backup.sh writes here by default. A custom-format dump is a copy of the
# whole database, including the accounts table and every password hash, so these
# must never reach the repository - `git add -A` would otherwise pick up the
# dump produced by an ordinary backup run. Keep the directory with a .gitkeep and
# put the real dumps on the server or on removable media.
backups/
*.dump
*.dump.sha256

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Project verification artifacts generated by tests/scripts
# ---------------------------------------------------------------------------
tests/**/*.log
tests/**/*-result.json